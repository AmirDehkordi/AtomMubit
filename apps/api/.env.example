# Mubit (use the key of the project this product records into, not the probe project)
MUBIT_API_KEY=mbt_...
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
AGENT_MODEL=gpt-6-luna
EXTRACTOR_MODEL=gpt-6-luna
# minimal | low | medium | high (gpt-6-luna is a reasoning model; low keeps the chat quick)
AGENT_REASONING_EFFORT=low

# SEC asks every client to identify itself with a contact address
SEC_USER_AGENT="Earnings Desk you@example.com"

# Leave empty to use embedded Postgres (PGlite) in data/pglite.
# With Docker: pnpm db:up, then DATABASE_URL=postgres://desk:desk@localhost:5432/desk
DATABASE_URL=

PORT=4000
WEB_ORIGIN=http://localhost:3100
