# openrouter = Mubit -> OpenRouter; mubit = native Mubit OpenAI/Gemini routes.
INFERENCE_BACKEND=openrouter
# Native model profile (used only when INFERENCE_BACKEND=mubit).
# Supported native families: bare gpt-* and gemini-* IDs.
MUBIT_AGENT_MODEL=gpt-6-luna
MUBIT_EXTRACTOR_MODEL=gemini-3.5-flash-lite
MUBIT_FEEDBACK_MODEL=gpt-6-luna
MUBIT_OPENAI_BASE_URL=https://api.mubit.ai/openai/v1
MUBIT_GEMINI_BASE_URL=https://api.mubit.ai/gemini

# Both profiles use your Mubit key. OpenRouter mode needs an OpenRouter provider key in Mubit.
# Native mode uses starter credit where offered, otherwise a provider key in Mubit.
MUBIT_API_KEY=
MUBIT_BASE_URL=https://api.mubit.ai/compat/openrouter/v1
AGENT_MODEL=openai/gpt-6-luna
EXTRACTOR_MODEL=qwen/qwen3-30b-a3b-instruct-2507
FEEDBACK_MODEL=openai/gpt-6-luna
AGENT_REASONING_EFFORT=low
# Optional: used only by explicitly selected direct OpenRouter evaluations.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Set a real name/contact email to enable automatic SEC ingestion. Empty disables monitoring.
SEC_USER_AGENT=
WATCHLIST_TICKERS=AAPL,MSFT,NVDA,WMT,JPM
TEAM_ID=internal
# Empty runs API and its local worker together on PGlite. Separate workers require PostgreSQL.
DATABASE_URL=
RUN_MIGRATIONS=1
RUN_LOCAL_WORKER=1
PORT=4000
WEB_ORIGIN=http://localhost:3100
# direct = local workflow calls gateway code directly; production model route still goes through Mubit.
WORKFLOW_MODE=direct
LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=
LANGFLOW_EXTRACTION_FLOW_ID=
LANGFLOW_FEEDBACK_FLOW_ID=
MODEL_GATEWAY_TOKEN=
